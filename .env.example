# ══════════════════════════════════════════════════════════════════════
#  DevOps Swarm — environment
#  Copy to .env and fill in the three required keys. Never commit .env.
# ══════════════════════════════════════════════════════════════════════

# ── Required ──────────────────────────────────────────────────────────

# Groq — free at https://console.groq.com  (API Keys → Create)
GROQ_API_KEY=gsk_your_groq_key_here

# E2B sandbox — free at https://e2b.dev  (Dashboard → API Keys)
E2B_API_KEY=e2b_your_e2b_key_here

# GitHub token used by the manual /trigger endpoint.
# Fine-grained token scoped to the repositories in REPO_ALLOWLIST, with
# Contents: read/write, Pull requests: read/write, Issues: read/write.
# A classic `repo`-scoped token also works but grants far more than needed.
GITHUB_PAT=github_pat_your_token_here


# ── Access control ────────────────────────────────────────────────────
# /trigger spends the credentials above against whatever repository it is
# handed. Both of these are enforced in production and validated at startup.

# Comma-separated API keys accepted on mutating endpoints.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Empty means no authentication — development only.
API_KEYS=

# Comma-separated "owner/repo" entries the swarm may act on.
# "*" allows every repository and is rejected when ENVIRONMENT=production.
REPO_ALLOWLIST=*


# ── GitHub App (optional — only for the webhook flow) ──────────────────
GITHUB_APP_ID=
# Full PEM with literal newlines replaced by \n
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=


# ── Runtime ───────────────────────────────────────────────────────────
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO
LOG_FORMAT=console               # console locally, json in production

# ── Infrastructure ────────────────────────────────────────────────────
POSTGRES_USER=swarm
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=devops_swarm
DATABASE_URL=postgresql+asyncpg://swarm:change-me-locally@postgres:5432/devops_swarm

CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Model and swarm behaviour ─────────────────────────────────────────
GROQ_MODEL=llama-3.3-70b-versatile
MAX_CORRECTION_ITERATIONS=3
MAX_REACT_ITERATIONS=25
MAX_CONCURRENT_RUNS=3

# Characters of a tool result passed back to the model. Too small and the
# coder reasons about fragments of files; too large and requests exceed the
# provider's per-request token limit.
TOOL_RESULT_CHAR_BUDGET=6000

# ── Rate limiting ─────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TRIGGERS_PER_HOUR=20
RATE_LIMIT_READS_PER_MINUTE=120
